{
	"info": {
		"name": "Laravel Marketplace API",
		"description": "Автоматично згенерована колекція для тестування Marketplace CRUD у Laravel",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get All Listings",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/listings",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"listings"
					]
				}
			}
		},
		{
			"name": "Get Listing By ID",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/listings/1",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"listings",
						"1"
					]
				}
			}
		},
		{
			"name": "Create Listing",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Нове оголошення\",\n    \"description\": \"Опис для нового оголошення\",\n    \"price\": 1500\n}"
				},
				"url": {
					"raw": "{{base_url}}/listings",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"listings"
					]
				}
			}
		},
		{
			"name": "Update Listing",
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"price\": 1200\n}"
				},
				"url": {
					"raw": "{{base_url}}/listings/1",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"listings",
						"1"
					]
				}
			}
		},
		{
			"name": "Delete Listing",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{base_url}}/listings/1",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"listings",
						"1"
					]
				}
			}
		}
	],
